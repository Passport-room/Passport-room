<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Make.pics — Instant Passport Photo Maker</title>
<meta name="description" content="Create compliant passport & visa photos in seconds. AI background removal runs fully in your browser: private, fast, and better." />
<meta property="og:title" content="Make.pics — Instant Passport Photo Maker" />
<meta property="og:description" content="AI passport photos in your browser. Private, instant, high-quality." />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="favicon.ico" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="style.css" />
</head>
<body>
<div id="app">
  <header class="top">
    <div class="topbar">
      <img id="logo" src="logo.png" alt="Make.pics" />
      <div class="topright">
        <span id="backendBadge" class="badge hidden"></span>
        <div class="btnGroup">
          <button id="profileBtn" class="iconBtn brand" aria-label="Your profile" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
          </button>
          <button id="menuBtn" class="iconBtn ghost" aria-label="Open menu" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
          </button>
          <div id="profileMenu" class="dropdown hidden">
            <div class="ddHead"><div class="ddName">Guest user</div><div class="ddSub">Not signed in</div></div>
            <button class="ddItem">Sign in</button>
            <button class="ddItem">My photos</button>
            <button class="ddItem">Settings</button>
          </div>
          <div id="menuMenu" class="dropdown hidden">
            <button class="ddItem" data-action="new">New photo</button>
            <button class="ddItem">Passport sizes</button>
            <button class="ddItem">How it works</button>
            <button class="ddItem">Privacy</button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section id="uploadView" class="view">
    <div class="crystalWrap" aria-hidden="true">
      <div class="crystalGlow"></div>
      <div id="crystalBox"><canvas id="crystalCanvas"></canvas></div>
    </div>
    <div class="hero">
      <h1>Passport photos<br /><span class="grad">in seconds</span></h1>
      <p class="lead">AI background removal runs fully in your browser. Private, fast, better.</p>
      <div class="features">
        <div class="feat">
          <div class="featI"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg></div>
          <div><div class="featT">Instant result</div><div class="featS">On-device AI</div></div>
        </div>
        <div class="feat">
          <div class="featI"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10v4M10 10v4M7 12h3" stroke-linecap="round"/><path d="M13.5 10v4M13.5 10h1.6a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-1.6" stroke-linecap="round"/></svg></div>
          <div><div class="featT">High quality</div><div class="featS">Precision matting</div></div>
        </div>
        <div class="feat">
          <div class="featI"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.4 7.7 8 9 4.6-1.3 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg></div>
          <div><div class="featT">Private &amp; secure</div><div class="featS">No uploads ever</div></div>
        </div>
      </div>
      <div id="drop" class="drop">
        <input id="fileInput" type="file" accept="image/*" hidden />
        <div class="dropInner">
          <div class="dropIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13" r="4"/></svg></div>
          <div class="dropTitle">Drop a photo or tap to choose</div>
          <div class="dropSub">JPG or PNG · Your image never leaves this device</div>
          <button id="pickBtn" class="btn primary">Choose photo</button>
        </div>
      </div>
      <div id="uploadError" class="err hidden"></div>
    </div>
  </section>

  <section id="processingView" class="view hidden">
    <div class="loader">
      <div class="loaderRing outer"></div>
      <div class="loaderRing inner"></div>
    </div>
    <div id="procTitle" class="procTitle">Warming up the AI…</div>
    <div id="procSub" class="procSub">Preparing your photo studio.</div>
  </section>

  <section id="resultView" class="view hidden">
    <div class="resultHead">
      <div class="resultHeadText">
        <h1>Your passport photo is ready</h1>
        <p class="muted small">Fine-tune framing, adjust, pick a background, then download.</p>
      </div>
      <button id="newBtn" class="btn ghost">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m21 15-5-5-9 9"/></svg>
        New image
      </button>
    </div>
    <div class="resultGrid">
      <div class="panel previewPanel">
        <div class="frameHead previewHead"><h3>Preview</h3></div>
        <div class="previewBox">
          <canvas id="previewCanvas"></canvas>
          <img id="tryOnResult" class="tryOnResult hidden" alt="AI dress try-on result" />
        </div>
      </div>

      <div class="panel editorPanel">
        <div class="editorHead">
          <h3>Adjust</h3>
          <button id="resetEdits" class="linkBtn">Reset all</button>
        </div>
        <div id="editorSliders" class="editorSliders"></div>
        <div class="editorHint muted small">Your last adjustments are saved on this device.</div>
      </div>

      <div id="tryOnPanel" class="panel tryOnPanel">
        <div class="tryOnHead">
          <span class="tryOnTitle">AI Dress Try-On</span>
          <span class="tryOnKeyStatus">Powered by IDM-VTON</span>
        </div>
        <div id="tryOnDresses" class="tryOnDresses"></div>
        <div id="tryOnCustom" class="tryOnCustom hidden">
          <label class="tryOnUpload">
            <input id="tryOnCustomFile" type="file" accept="image/*" hidden />
            <span id="tryOnCustomFileLabel">Upload garment image</span>
          </label>
          <img id="tryOnCustomPreview" class="tryOnCustomPreview hidden" alt="Custom garment" />
          <textarea id="tryOnCustomPrompt" class="tryOnPrompt" rows="2" placeholder="Describe the garment (optional if you uploaded an image)"></textarea>
          <div class="tryOnCustomHint muted small">Provide an image, a prompt, or both.</div>
        </div>
        <div class="tryOnActionRow">
          <button id="tryOnGenerate" class="tryOnBtn primary" disabled>Change clothes</button>
          <button id="tryOnRevert" class="tryOnBtn ghost hidden">Revert</button>
        </div>
        <div class="tryOnHint">Runs on a free Hugging Face VTON space. First request may take 30–60s.</div>
        <div id="tryOnStatus" class="tryOnStatus"></div>
      </div>

      <div id="enhancePanel" class="panel tryOnPanel enhancePanel">
        <div class="tryOnHead">
          <span class="tryOnTitle">AI Enhance</span>
          <span class="tryOnKeyStatus">CodeFormer face restore</span>
        </div>
        <div class="enhanceRow">
          <div class="enhanceScale" role="radiogroup" aria-label="Upscale factor">
            <button type="button" class="enhanceScaleBtn active" data-scale="2x">2×</button>
            <button type="button" class="enhanceScaleBtn" data-scale="4x">4×</button>
          </div>
          <button id="enhanceGenerate" class="tryOnBtn primary" disabled>Enhance photo</button>
          <button id="enhanceRevert" class="tryOnBtn ghost hidden">Revert</button>
        </div>
        <div class="tryOnHint">Face-safe super-resolution — sharpens detail and restores facial features.</div>
        <div id="enhanceStatus" class="tryOnStatus"></div>
      </div>

      <div class="panel cropPanel">
        <div class="frameHead">
          <h3>Crop</h3>
          <label class="chk"><input id="guidesChk" type="checkbox" checked /> Guides</label>
        </div>
        <label class="slider"><span class="sliderLabel">Zoom</span><input id="zoom" type="range" min="0.6" max="1.8" step="0.01" value="1"/><span class="sliderValue" id="zoomVal">1.00×</span></label>
        <label class="slider"><span class="sliderLabel">Vertical</span><input id="offY" type="range" min="-0.35" max="0.35" step="0.005" value="0"/><span class="sliderValue" id="offYVal">0</span></label>
        <label class="slider"><span class="sliderLabel">Horizontal</span><input id="offX" type="range" min="-0.35" max="0.35" step="0.005" value="0"/><span class="sliderValue" id="offXVal">0</span></label>
        <button id="resetFrame" class="linkBtn">Reset crop</button>
      </div>
      <div class="optionRow">
        <div class="panel small">
          <div class="pTitle">Photo size</div>
          <select id="specSelect"></select>
          <div id="specMeta" class="muted small"></div>
          <div class="fmt" style="margin-top:10px">
            <button data-fmt="jpeg" class="fmtBtn active">JPEG</button>
            <button data-fmt="png" class="fmtBtn">PNG</button>
          </div>
        </div>
        <div class="panel small">
          <div class="pTitle">Background</div>
          <div id="bgSwatches" class="swatches"></div>
        </div>
      </div>
      <div class="downloadStack">
        <div class="downloadBtns">
          <button id="dlSheet" class="btn ghost">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M4 9h16M4 15h16M10 3v18"/></svg>
            Download A4 sheet
          </button>
          <button id="dlSingle" class="btn primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/></svg>
            Download single
          </button>
          <button id="dlPrint" class="btn ghost">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="9" width="12" height="9" rx="1"/><path d="M8 9V5h8v4"/><path d="M6 14H4v-3a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3h-2"/></svg>
            Directly Print
          </button>
        </div>
        <div id="timings" class="muted small center"></div>
        <div id="resultError" class="err hidden"></div>
      </div>
    </div>
  </section>

  <div id="downloadModal" class="modalOverlay hidden">
    <div class="modalBox">
      <div class="modalIcon">↓</div>
      <div class="modalTitle">Your image is downloading…</div>
      <p class="modalSub muted small">Check your device's downloads folder for the file.</p>
      <div class="modalBtns">
        <button id="modalNewImage" class="btn primary">New image</button>
        <button id="modalHome" class="btn ghost">Home</button>
      </div>
    </div>
  </div>

  <footer class="siteFooter">
    <section class="articles" data-home-only aria-labelledby="articlesTitle">
      <header class="articlesHead">
        <div class="aboutKicker">Insights</div>
        <h2 id="articlesTitle" class="aboutTitle">From the <span class="grad">Make.pics</span> journal</h2>
        <p class="articlesLead">Practical, in-depth reads on modern imaging, composition, and the craft of building fast, beautiful visuals for the web.</p>
      </header>
      <div class="articleGrid">
        <article class="articleCard">
          <div class="articleThumb" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><circle cx="9" cy="11" r="2"/><path d="m5 18 5-5 4 4 3-3 2 2"/></svg>
          </div>
          <div class="articleBody">
            <div class="articleMeta"><span class="tag">AI &amp; Craft</span><span>· 5 min read</span></div>
            <h3 class="articleTitle">The Future of Visual Storytelling: How AI and Photography Collide</h3>
            <p class="articleExcerpt">Explore how modern creators are leveraging automated tools to enhance high-resolution imagery without losing the human touch.</p>
            <p class="articleStub">In a world dominated by rapid digital consumption, the fusion of traditional photography and AI-driven image editing is redefining creativity. This article explores how creators can balance automation with genuine artistic intent to stand out in a crowded digital landscape.</p>
          </div>
        </article>

        <article class="articleCard">
          <div class="articleThumb" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
          </div>
          <div class="articleBody">
            <div class="articleMeta"><span class="tag">Composition</span><span>· 7 min read</span></div>
            <h3 class="articleTitle">Mastering Digital Composition: 5 Rules Every Creator Should Break</h3>
            <p class="articleExcerpt">A deep dive into advanced framing techniques, color theory, and why breaking traditional design rules can elevate your portfolio.</p>
            <p class="articleStub">While the "rule of thirds" is a great starting point, true visual innovation happens when you know how and when to break the rules. We analyze successful modern designs that defy standard conventions to create unforgettable visual impact.</p>
          </div>
        </article>

        <article class="articleCard">
          <div class="articleThumb" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg>
          </div>
          <div class="articleBody">
            <div class="articleMeta"><span class="tag">Performance</span><span>· 6 min read</span></div>
            <h3 class="articleTitle">Optimizing Web Images for Maximum Speed and Crystal-Clear Resolution</h3>
            <p class="articleExcerpt">Slow loading times kill conversions. Learn the exact compression techniques to keep your site lightning-fast while maintaining flawless quality.</p>
            <p class="articleStub">High-quality images shouldn't come at the cost of website performance. Discover how modern formats like WebP and smart compression algorithms allow you to host gorgeous visuals without compromising on load speeds or SEO rankings.</p>
          </div>
        </article>
      </div>
    </section>

    <div class="aboutCard" data-home-only>
      <div class="aboutHead">
        <div class="aboutBadge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg>
        </div>
        <div>
          <div class="aboutKicker">About</div>
          <h2 class="aboutTitle">About <span class="grad">Make.pics</span></h2>
        </div>
      </div>
      <p class="aboutText">
        Make.pics is a fully in-browser passport and visa photo studio. Our AI segmentation
        model runs locally on your device using WebGPU (with a WebAssembly fallback), so your
        photo never leaves your computer or phone. There are no uploads, no cloud processing,
        no accounts, and no tracking of your images — just an instant, professional result.
      </p>
      <p class="aboutText">
        Behind the scenes we combine a modern neural background-removal pipeline with an
        edge-aware compositor and a color-managed rendering engine. That means clean hair
        edges, accurate skin tones, and print-ready output at the exact millimeter and DPI
        specifications used by governments around the world — US, Schengen, UK, Canada,
        India, China, Australia, Japan and many more presets are built in.
      </p>
      <p class="aboutText">
        You stay in full creative control. Adjust framing with live compliance guides, tune
        brightness, contrast, exposure, shadows, highlights, clarity and noise, pick a
        compliant white or off-white background (or any custom color), and export as JPEG
        or PNG. Need a physical copy? Generate a perfectly tiled 4×6″ print sheet ready for
        home printers or any photo kiosk — all in seconds, all on your device.
      </p>
      <ul class="aboutList">
        <li>
          <span class="aboutIcon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.4 7.7 8 9 4.6-1.3 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
          </span>
          <div>
            <div class="aboutItemT">On-device AI background removal</div>
            <div class="aboutItemS">Private by design — your image never leaves this device.</div>
          </div>
        </li>
        <li>
          <span class="aboutIcon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h6v6H4z"/><path d="M14 14h6v6h-6z"/><path d="M14 4h6v6h-6z" opacity=".6"/><path d="M4 14h6v6H4z" opacity=".6"/></svg>
          </span>
          <div>
            <div class="aboutItemT">Adjustable framing, zoom & rotation</div>
            <div class="aboutItemS">Dial in the perfect crop with live guides.</div>
          </div>
        </li>
        <li>
          <span class="aboutIcon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M2 12h20"/><path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
          </span>
          <div>
            <div class="aboutItemT">Multiple passport & visa presets</div>
            <div class="aboutItemS">US, Schengen, UK, India, Canada, China, Australia and more.</div>
          </div>
        </li>
        <li>
          <span class="aboutIcon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/></svg>
          </span>
          <div>
            <div class="aboutItemT">Download as JPEG or PNG</div>
            <div class="aboutItemS">High-resolution files ready for online applications.</div>
          </div>
        </li>
        <li>
          <span class="aboutIcon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="9" width="12" height="9" rx="1"/><path d="M8 9V5h8v4"/><path d="M6 14H4v-3a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3h-2"/></svg>
          </span>
          <div>
            <div class="aboutItemT">4×6″ print sheet option</div>
            <div class="aboutItemS">Auto-tiled layout for one-click home or kiosk printing.</div>
          </div>
        </li>
      </ul>
    </div>
    <div class="footNote">© <span id="year"></span> Make.pics · Made for private, on-device photo editing.</div>
  </footer>
</div>
<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.js",
    "onnxruntime-web/webgpu": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.27.0/dist/ort.webgpu.bundle.min.mjs"
  }
}
</script>
<script>document.getElementById("year").textContent = new Date().getFullYear();</script>
<script type="module" src="app.js"></script>
<script type="module" src="dress-tryon.js"></script>
<script type="module" src="enhance.js"></script>
</body>
</html>
