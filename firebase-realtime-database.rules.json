{
  "rules": {
    ".read": false,
    ".write": false,

    "counters": {
      "customerSeq": {
        ".read": true,
        ".write": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
      }
    },

    "customers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$cid": {
        ".write": "$cid.matches(/^CUS-[0-9]{6}$/) && (auth == null ? !data.exists() || newData.child('firstVisit').val() == data.child('firstVisit').val() : root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['id','firstVisit','lastVisit','visitCount','deviceType'])",
        "id": { ".validate": "newData.val() === $cid" },
        "firstVisit": { ".validate": "newData.isNumber()" },
        "lastVisit": { ".validate": "newData.isNumber()" },
        "visitCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000" },
        "photosCreated": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "deviceType": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "os": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "browser": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "userAgent": { ".validate": "newData.isString() && newData.val().length <= 400" },
        "$other": { ".validate": false }
      }
    },

    "status": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$cid": {
        ".write": "$cid.matches(/^CUS-[0-9]{6}$/)",
        ".validate": "newData.hasChildren(['online','lastChanged'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastChanged": { ".validate": "newData.isNumber()" },
        "deviceType": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "$other": { ".validate": false }
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
