# Payment + membership configuration (server-side only).
# On Vercel: Project Settings -> Environment Variables. Never commit real values.

# LIVE payments. Leave as "production" (only set "sandbox" for testing).
PADDLE_ENVIRONMENT=production

# Paddle client-side token (publishable, used by Paddle.js in the browser)
PADDLE_CLIENT_TOKEN=

# Paddle API key (SECRET - server only, used to look up the buyer's email)
PADDLE_API_KEY=

# Paddle notification SIGNING SECRET (SECRET - server only).
# Paddle > Developer Tools > Notifications > your LIVE destination > Signing secret.
# This is NOT the API key: pntfset_... , never ntfset/apikey mix-ups.
# Destination URL: https://<your-domain>/api/public/paddle/webhook
PADDLE_WEBHOOK_SECRET=

# The $0.99 / 30 days price. Must be a price id (pri_...), not a product id.
PADDLE_PRICE_ID=

# Optional: product id (pro_...) used as a fallback when the stored price id
# no longer matches the payment. Leave empty if you only sell one price.
PADDLE_PRODUCT_ID=

# Optional: secret for the admin membership recovery call
# PUT /api/public/membership/restore  { "secret": "...", "email": "buyer@example.com",
#                                      "transactionId": "txn_..." (optional) }
# Defaults to FIREBASE_DB_SECRET when left empty.
MEMBERSHIP_ADMIN_SECRET=

# Firebase Realtime Database secret (SECRET - server only)
FIREBASE_DB_SECRET=

# Optional: label shown on the payment page (defaults to $0.99)
PADDLE_PRICE_LABEL=$0.99

# Customer portal (/account) uses PADDLE_API_KEY + PADDLE_ENVIRONMENT above.
# Webhook destination URL: https://<your-domain>/api/public/paddle/webhook
# Events: transaction.completed, subscription.created/updated/canceled,
#         customer.created/updated
