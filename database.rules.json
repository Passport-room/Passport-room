{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "counters": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "customerNumber": {
        ".write": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
      }
    },

    "devices": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$deviceId": {
        ".write": "!data.exists() && newData.isString() && newData.val().length <= 20"
      }
    },

    "customers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": "lastVisit",
      "$customerId": {
        ".write": "false"
      }
    },

    "reviews": {
      ".read": true,
      ".indexOn": "ts",
      "$reviewId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['rating','text','ts'])",
        "deviceId":   { ".validate": "newData.isString() && newData.val().length <= 64" },
        "customerId": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "uid":        { ".validate": "newData.isString() && newData.val().length <= 128" },
        "name":       { ".validate": "newData.isString() && newData.val().length <= 40" },
        "source":     { ".validate": "newData.isString() && newData.val().length <= 160" },
        "color":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "rating":     { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
        "text":       { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 300" },
        "ts":         { ".validate": "newData.isNumber()" },
        "$other":     { ".validate": false }
      }
    },

    "referrals": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": "ts",
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['source','ts'])",
        "source":      { ".validate": "newData.isString() && newData.val().matches(/^(search|social|ai|other)$/)" },
        "sourceLabel": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "detail":      { ".validate": "newData.isString() && newData.val().length <= 120" },
        "uid":         { ".validate": "newData.isString() && newData.val().length <= 128" },
        "page":        { ".validate": "newData.isString() && newData.val().length <= 200" },
        "ts":          { ".validate": "newData.isNumber()" },
        "$other":      { ".validate": false }
      }
    },

    "stats": {
      ".read": true,
      "$field": {
        ".write": "auth != null && ($field === 'visitors' || $field === 'photos') && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    }
  }
}
