{
  "rules": {
    ".read": false,
    ".write": false,

    "counters": {
      "customerNumber": {
        ".read": "auth != null",
        ".write": "auth != null && newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
      }
    },

    "customers": {
      ".read": "auth != null && auth.token.email === 'nexohubyt@gmail.com'",
      ".indexOn": "lastVisit",

      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'visitCount', 'lastVisit'])",

        "id": { ".validate": "newData.isString()" },
        "uid": { ".validate": "newData.isString() && newData.val() === $uid" },
        "browser": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "deviceType": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "os": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "screen": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "userAgent": { ".validate": "newData.isString() && newData.val().length <= 400" },
        "country": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "countryCode": { ".validate": "newData.isString() && newData.val().length <= 4" },
        "visitCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "photoCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "totalMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "firstVisit": { ".validate": "newData.isNumber()" },
        "lastVisit": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
