{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['code'])",

        "code": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "migratedFrom": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "deviceIds": {
          "$deviceId": { ".validate": "newData.isBoolean()" }
        },
        "deviceType": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "browser": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "os": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "screen": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "language": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "timeZone": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "userAgent": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "country": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "countryCode": { ".validate": "newData.isString() && newData.val().length <= 8" },

        "visits": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
        },
        "totalMs": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
        },
        "photos": {
          "$kind": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
          }
        },

        "createdAt": { ".validate": "newData.isNumber()" },
        "lastSeenAt": { ".validate": "newData.isNumber()" },

        "$other": { ".validate": false }
      }
    },

    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString() && newData.val().length <= 128 && $code.length <= 24"
      }
    },

    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null && newData.isString() && newData.val() === auth.uid"
      }
    },

    "customers": {
      "$customerId": {
        ".read": "auth != null",
        ".write": false
      }
    }
  }
}
