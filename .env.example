# Payment + membership configuration (server-side only).
# On Vercel: Project Settings -> Environment Variables. Never commit real values.

# "sandbox" while testing, "production" when live
PADDLE_ENVIRONMENT=sandbox

# Paddle client-side token (publishable, used by Paddle.js in the browser)
PADDLE_CLIENT_TOKEN=

# Paddle API key (SECRET - server only, used to look up the buyer's email)
PADDLE_API_KEY=

# Paddle notification/webhook signing secret (SECRET - server only)
PADDLE_WEBHOOK_SECRET=

# The $0.99 / 30 days price. Must be a price id (pri_...), not a product id.
PADDLE_PRICE_ID=

# Firebase Realtime Database secret (SECRET - server only)
FIREBASE_DB_SECRET=

# Optional: label shown on the payment page (defaults to $0.99)
PADDLE_PRICE_LABEL=$0.99
